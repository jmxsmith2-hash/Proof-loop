<link rel="icon" href="{{ favicon }}">
<style>{{ theme_css }}</style>
<style>
main { max-width: 1060px; padding-top: 24px; }
.brand { margin-bottom: 12px; }
h1 { font-size: 26px; } h2 { font-size: 19px; margin: 34px 0 10px; } h3 { font-size: 16px; margin: 0 0 4px; }
.secondary { color: var(--ink-2); }
.banner { display: block; background: var(--warn-soft); border-left: 4px solid var(--warn); margin: 14px 0; }
.card { margin: 10px 0; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.stat { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; }
.stat b { display: block; font-size: 22px; font-variant-numeric: tabular-nums; } .stat span { color: var(--ink-2); font-size: 13px; }
.views { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
.views figure { margin: 0; } .views img, .finding img { width: 100%; border-radius: 8px; border: 1px solid var(--line); background: #f8f8f6; }
figcaption { font-size: 12px; color: var(--muted); text-align: center; }
.finding { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); gap: 16px; }
@media (max-width: 720px) { .finding { grid-template-columns: 1fr; } }
.num { display: inline-block; min-width: 26px; padding: 1px 7px; border-radius: 7px; color: #fff; font-weight: 700; margin-right: 6px; text-align: center; }
.chip { margin-right: 4px; }
.fix { border-left: 3px solid var(--ok); padding: 4px 10px; margin: 8px 0; font-size: 14px; }
table { font-size: 14px; }
.ok { color: var(--ok); font-weight: 600; } .bad { color: var(--bad); font-weight: 600; }
</style>
