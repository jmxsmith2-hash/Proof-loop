<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.model }}: ready to print?</title>
{% include "_style.html.j2" %}
<style>
.verdict { border-radius: 14px; padding: 18px 20px; margin: 14px 0; border: 2px solid var(--line); background: var(--panel); }
.verdict.ready { border-color: var(--ok); } .verdict.fix { border-color: var(--sev3); }
.verdict h2 { margin: 0 0 4px; font-size: 22px; }
.links a { margin-right: 14px; font-weight: 600; }
</style>
</head>
<body><main>
<div class="brand">{{ icon }}ProofLoop</div>
<h1>{{ r.model }}</h1>
<p class="secondary small">{{ (r.printer.names or [r.printer.name])[0] }} · {{ r.material.name }} · sliced by {{ r.slicer.name }} with
  "{{ r.presets.process }}" and "{{ r.presets.filament }}"{% if r.presets.overrides %} (support {{ 'on' if r.presets.overrides.process.enable_support else 'off' }}){% endif %} · {{ r.generated[:16] }}</p>

<div class="verdict {{ 'ready' if r.ready else 'fix' }}">
  <h2 class="{{ 'ok' if r.ready else 'bad' }}">{{ 'Ready to print' if r.ready else 'Fix ' ~ r.blocking ~ ' thing' ~ ('s' if r.blocking != 1 else '') ~ ' first' }}</h2>
  <p>{{ r.grams }} g of filament, {{ r.time }}, {{ r.layers }} layers (the slicer's numbers).</p>
  <p class="links small"><a href="{{ r.links.design }}">Design check</a><a href="{{ r.links.gcode }}">G-code check</a>{% if r.links.loop %}<a href="{{ r.links.loop }}">Loop file check</a>{% endif %}<a href="{{ r.links.sliced }}">Sliced file</a></p>
</div>

{% if r.rounds %}<h2>Settings changed and sliced again</h2>
<div class="card small"><table><tr><th>Round</th><th>Changed</th><th class="n">Problems before</th><th class="n">after</th></tr>
{% for rd in r.rounds %}<tr><td>{{ loop.index + 1 }}</td><td>{% for st in rd.applied %}{{ st.label }} = <b>{{ st.value }}</b>{% if not loop.last %}<br>{% endif %}{% endfor %}</td><td class="n">{{ rd.blocking_before }}</td><td class="n">{{ rd.blocking_after }}</td></tr>{% endfor %}</table>
<p class="muted">The final slice above uses these settings; set them in your slicer (or import the presets from the G-code check) for the real print.</p></div>{% endif %}

{% if r.setting_fixes %}<h2>Slicer settings that would fix it</h2>
<div class="card small"><table>{% for st in r.setting_fixes %}<tr><td>{{ st.label }}</td><td class="n"><b>{{ st.value }}</b></td><td>{{ st.why }}</td></tr>{% endfor %}</table>
<p class="muted">Run again with <code>--fix</code> to apply them and slice again.</p></div>{% endif %}

{% if r.slicer_findings %}<h2>What the slicer did with the design</h2>
{% if r.alignment_note %}<p class="small muted">Note: {{ r.alignment_note }}.</p>{% endif %}
{% for f in r.slicer_findings %}<div class="card"><h3><span class="num sev{{ f.severity }}">!</span>{{ f.title }}</h3>
  <p>{{ f.detail }}</p><div class="fix"><b>Fix:</b> {{ f.fix }}</div></div>{% endfor %}{% endif %}

{% set top = (r.design.findings + r.gcode.findings)|selectattr('severity', 'ge', 3)|list %}
{% if top %}<h2>Major problems</h2>
{% for f in top %}<div class="card"><h3><span class="num sev{{ f.severity }}">{{ f.n }}</span>{{ f.title }}</h3>
  <span class="chip">{{ 'design' if f in r.design.findings else 'G-code' }}</span><span class="chip">{{ f.severity_name }}</span>
  <p>{{ f.detail }}</p>{% if f.fix %}<div class="fix"><b>Fix:</b> {{ f.fix }}</div>{% endif %}</div>{% endfor %}{% endif %}

{% if r.loop %}<h2>Loop file</h2><div class="card small"><p>{{ r.loop.file }}: {{ r.loop.metrics.loop_file.loops }} loops,
  {{ r.loop.findings|selectattr('severity', 'ge', 3)|list|length }} major problem(s). <a href="{{ r.links.loop }}">Open its check</a>.</p></div>{% endif %}

<h2>Limitations</h2>
<ul class="card small">
  <li>The slicer ran with its own presets for this printer and filament; your usual presets in the slicer app may differ.</li>
  <li>The comparison matches places by position on the plate; if the slicer turned the part, they are approximate.</li>
</ul>
</main></body></html>
