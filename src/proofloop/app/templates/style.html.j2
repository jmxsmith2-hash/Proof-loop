<style>
:root { color-scheme: light; --bg: #f6f5f2; --card: #fcfcfb; --border: #dedcd5; --text: #0b0b0b; --text-secondary: #52514e;
  --muted: #6e6d68; --accent: #2a78d6; --warn-bg: #fff4dc; --warn: #eda100; --warn-text: #5c3d00;
  --series-1: #2a78d6; --series-2: #eb6834; }
@media (prefers-color-scheme: dark) { :root:where(:not([data-theme="light"])) { color-scheme: dark; --bg: #121211; --card: #1a1a19;
  --border: #383835; --text: #f0efec; --text-secondary: #c3c2b7; --muted: #9a998f; --accent: #5598e7; --warn-bg: #2e2510;
  --warn: #c98500; --warn-text: #f3d48a; --series-1: #3987e5; --series-2: #d95926; } }
:root[data-theme="dark"] { color-scheme: dark; --bg: #121211; --card: #1a1a19; --border: #383835; --text: #f0efec;
  --text-secondary: #c3c2b7; --muted: #9a998f; --accent: #5598e7; --warn-bg: #2e2510; --warn: #c98500; --warn-text: #f3d48a;
  --series-1: #3987e5; --series-2: #d95926; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 24px; margin: 0; } h2 { font-size: 18px; margin: 32px 0 10px; }
a { color: var(--accent); }
.banner { background: var(--warn-bg); border: 1px solid var(--warn); color: var(--warn-text); border-radius: 10px; padding: 10px 14px; margin: 12px 0; font-size: 14px; }
.card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 8px 14px; overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; white-space: nowrap; }
td.wrap { white-space: normal; } td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
th { color: var(--text-secondary); font-weight: 600; } .muted { color: var(--muted); font-size: 13px; }
.chart text { fill: var(--text-secondary); font-size: 12px; } .chart .axis, .chart .grid { stroke: var(--border); }
.chart .direct-label { fill: var(--text); }
.legend { display: flex; gap: 14px; font-size: 13px; color: var(--text-secondary); margin: 8px 0; }
.legend-item { display: inline-flex; align-items: center; gap: 6px; } .swatch { width: 14px; height: 4px; border-radius: 2px; display: inline-block; }
.shot { max-width: 420px; width: 100%; border: 1px solid var(--border); border-radius: 8px; display: block; }
.step { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: 16px; padding: 14px 0;
  border-bottom: 1px solid var(--border); }
@media (max-width: 760px) { .step { grid-template-columns: 1fr; } }
.chip { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px; border: 1px solid var(--border);
  color: var(--text-secondary); margin: 2px 4px 2px 0; }
.chip.bad { border-color: var(--warn); color: var(--warn-text); background: var(--warn-bg); }
dl { margin: 6px 0; } dt { color: var(--muted); font-size: 12px; } dd { margin: 0 0 6px; }
</style>
