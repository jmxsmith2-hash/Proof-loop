<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Invoice {{ number }}</title>
<link rel="icon" href="{{ favicon }}">
<style>{{ theme_css }}</style>
<style>
main { max-width: 800px; }
.sheet { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 36px 40px; }
.top { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.top h1 { font-size: 30px; margin: 0 0 6px; }
.from { text-align: right; line-height: 1.45; }
.from .name { font-size: 17px; font-weight: 700; }
.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin: 28px 0 22px; }
.meta small { display: block; color: var(--muted); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .045em; }
.meta b { font-size: 16px; }
.blank { display: inline-block; min-width: 11em; border-bottom: 1px dotted var(--muted); color: var(--muted); font-style: italic; font-size: 13px; }
.amt { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.total td { font-weight: 700; font-size: 16px; border-bottom: 0; padding-top: 12px; }
.sub td { color: var(--muted); border-bottom: 0; font-size: 13px; padding-top: 2px; }
.notes, .foot { margin-top: 24px; white-space: pre-line; }
.notes small { display: block; color: var(--muted); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .045em; }
.paid { display: inline-block; margin-top: 18px; border: 2px solid var(--ok); color: var(--ok); border-radius: 8px; padding: 2px 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
.bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
@media print {
  html, body { background: #fff; }
  main { max-width: none; padding: 0; }
  .sheet { border: 0; box-shadow: none; padding: 0; }
  .noprint { display: none !important; }
  .blank { color: transparent; }
}
</style>
</head>
<body><main>
{% macro blank(v, hint) %}{% if v %}{{ v }}{% else %}<span class="blank">{{ hint }}</span>{% endif %}{% endmacro %}
<div class="bar noprint">
  <span class="muted small">Print this page, or choose "Save as PDF" in the print window.{% if not business.name or not business.address or not business.email %} Your business details are blank: fill them in on the Orders page.{% endif %}</span>
  <button class="btn primary" id="print" type="button">Print / Save as PDF</button>
</div>
<div class="sheet">
  <div class="top">
    <div><h1>Invoice</h1><div class="muted">{{ number }}</div></div>
    <div class="from">
      <div class="name">{{ blank(business.name, "Your business name") }}</div>
      {% if business.address %}{% for line in business.address %}<div>{{ line }}</div>{% endfor %}{% else %}<div>{{ blank("", "Address") }}</div>{% endif %}
      <div>{{ blank(business.email, "Email") }}</div>
      <div>{% if business.tax_id %}Tax ID: {{ business.tax_id }}{% else %}Tax ID: {{ blank("", "Tax ID") }}{% endif %}</div>
    </div>
  </div>
  <div class="meta">
    <div><small>Billed to</small><b>{{ customer }}</b></div>
    <div><small>Invoice date</small><b>{{ date }}</b></div>
    <div><small>Order date</small><b>{{ ordered }}</b></div>
  </div>
  <table>
    <thead><tr><th>Description</th><th class="amt">Parts</th><th class="amt">Price per part</th><th class="amt">Amount</th></tr></thead>
    <tbody>
    {% for line in lines %}
      <tr><td>{{ line.description }}</td><td class="amt">{{ line.qty }}</td>
        <td class="amt">{{ blank(line.unit, "price") }}</td><td class="amt">{{ blank(line.amount, "amount") }}</td></tr>
    {% endfor %}
      <tr class="total"><td colspan="3" class="amt">Total</td><td class="amt">{{ blank(total, "total") }}</td></tr>
    {% if tax %}<tr class="sub"><td colspan="3" class="amt">Includes tax ({{ "%g"|format(tax.pct) }}%)</td><td class="amt">{{ tax.amount }}</td></tr>{% endif %}
    </tbody>
  </table>
  {% if paid_on %}<div class="paid">Paid {{ paid_on }}</div>{% endif %}
  {% if notes %}<div class="notes"><small>Notes</small>{{ notes }}</div>{% endif %}
  {% if business.footer %}<div class="foot">{{ business.footer }}</div>{% endif %}
</div>
<script>document.getElementById("print").addEventListener("click", function () { window.print(); });</script>
</main></body>
</html>
