<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · ProofLoop</title>
{% include "style.html.j2" %}
</head>
<body><main>
<p class="muted"><a href="/">← Results</a>{% if back %} · <a href="{{ back.href }}">{{ back.label }}</a>{% endif %}</p>
<h1>Sessions of {{ run.id }}</h1>
<p class="muted">{{ run.study }} · {{ run.created_at[:16].replace('T', ' ') }} · <a href="/run/{{ run.id }}">report</a></p>
<div class="banner warn">{{ disclaimer }}</div>
<div class="card"><table>
<tr><th>Session</th><th>Persona</th><th>Task</th><th>Device</th><th>Outcome</th><th class="num">Steps</th><th class="num">Frustration</th><th class="num">Issues</th></tr>
{% for s in sessions %}<tr><td><a href="/session/{{ s.id }}">{{ s.id }}</a></td><td>{{ s.persona }}</td><td>{{ s.task_id }}</td>
  <td>{{ s.device }}</td><td>{{ s.outcome }}{% if s.repeat_index %} <span class="muted">rep{{ s.repeat_index }}</span>{% endif %}</td>
  <td class="num">{{ s.steps_count }}</td><td class="num">{{ '%.0f' % s.final_frustration }}</td><td class="num">{{ s.issues }}</td></tr>{% endfor %}
</table></div>
</main></body></html>
