<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · ProofLoop</title>
{% include "style.html.j2" %}
</head>
<body><main>
<p class="muted"><a href="/">← Results</a>{% if back %} · <a href="{{ back.href }}">{{ back.label }}</a>{% endif %}</p>
<h1>{{ persona }} · {{ session.task_id }}</h1>
<p class="muted">{{ session.id }} · {{ device }} · outcome <b>{{ session.outcome }}</b>{% if session.quit_reason %}: “{{ session.quit_reason }}”{% endif %}
  · {{ session.steps_count }} steps · frustration {{ '%.0f' % session.final_frustration }}</p>
<div class="banner warn">{{ disclaimer }}</div>
{% if issues %}<h2>Issues raised in this session</h2>
<div class="card"><table><tr><th>Step</th><th>Issue</th><th>Status</th><th>Replay</th></tr>
{% for i in issues %}<tr><td><a href="#step{{ i.step_idx }}">{{ i.step_idx + 1 }}</a></td><td class="wrap">{{ i.title }}: {{ i.description }}</td>
  <td>{{ i.status }}</td><td>{{ i.replay_status or '–' }}</td></tr>{% endfor %}</table></div>{% endif %}
<h2>Step by step</h2>
<div class="card">
{% for st in steps %}<div class="step" id="step{{ st.idx }}">
  <div>{% if st.shot %}<a href="{{ st.shot }}"><img class="shot" src="{{ st.shot }}" loading="lazy" alt="Screen before step {{ st.idx + 1 }}"></a>{% endif %}</div>
  <div>
    <b>Step {{ st.idx + 1 }}</b> <span class="muted">{{ st.screen_id }}</span><br>
    <b>{{ st.action }}</b>{% if st.slip %} <span class="chip bad">simulated slip: {{ st.slip }}</span>{% endif %}
    <dl><dt>Sees</dt><dd>{{ st.think.sees }}</dd><dt>Expects</dt><dd>{{ st.think.expects }}</dd>
      <dt>Does</dt><dd>{{ st.think.does }}</dd><dt>Feels</dt><dd>{{ st.think.feels }}</dd></dl>
    {% for sig in st.signals %}<span class="chip{% if sig in bad_signals %} bad{% endif %}">{{ sig|replace('_', ' ') }}</span>{% endfor %}
    <span class="muted">frustration {{ '%.0f' % st.frustration }}</span>
  </div>
</div>{% endfor %}
</div>
</main></body></html>
